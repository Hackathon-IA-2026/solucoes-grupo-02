# Chaves da API da NVIDIA (integrate.api.nvidia.com)
# Copie para .env e preencha:  cp .env.example .env
NVIDIA_KEY_CLASSIFIER=nvapi-...
NVIDIA_KEY_SUMMARIZER=nvapi-...
# Copiloto: embeddings e respostas (sem ela, usa a NVIDIA_KEY_SUMMARIZER)
NVIDIA_KEY_COPILOTO=nvapi-...

# Opcional — Amazon Bedrock no lugar da NVIDIA (é o que o deploy na AWS usa; ver functions/bedrock.py).
# Precisa de credenciais da AWS no ambiente (`aws configure`).
# BEDROCK_MODEL_ID: classificador, resumidor e copiloto. Ex.: us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_EMBEDDING_MODEL_ID: embeddings. Ex.: amazon.titan-embed-text-v2:0 — trocar o modelo de embedding
# exige vetorizar a base de novo (carregar_canonicas.py e main.py de cada dia já coletado).
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
AWS_REGION=us-east-1

# Para onde o pipeline envia o resultado (POST /interno/ingestao).
# Local: http://localhost:3000 · docker-compose: http://api:3333 · AWS: https://<host>/api
API_URL=http://localhost:3000
# A mesma chave configurada no .env da API.
INTERNAL_API_KEY=
