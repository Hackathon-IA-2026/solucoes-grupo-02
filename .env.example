NODE_ENV="dev"
DB_USER=
DB_NAME=
DB_PASSWORD=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173
COMPANY_NAME="Sua Empresa Ltda"
