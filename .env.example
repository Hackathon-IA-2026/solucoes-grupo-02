NODE_ENV="dev"
DB_USER=
DB_NAME=
DB_PASSWORD=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173
# Só para migrar bancos de antes do cadastro por empresa: na inicialização, usuários,
# usina e alertas sem empresa são ligados a uma empresa com estes dados (o usuário
# mais antigo vira admin). Empresas novas se cadastram pela tela de cadastro.
COMPANY_NAME="Sua Empresa Ltda"
COMPANY_CNPJ="00.000.000/0001-00"

# Chave que o serviço Python manda no header `x-internal-key` ao chamar as rotas
# /interno/* (ex.: POST /interno/ingestao). Sem ela, essas rotas ficam desligadas.
INTERNAL_API_KEY=

# Chaves da API da NVIDIA usadas pelo pipeline em ai/ quando roda pelo docker-compose
# (fora do docker, o pipeline lê ai/.env — veja ai/.env.example).
NVIDIA_KEY_CLASSIFIER=
NVIDIA_KEY_SUMMARIZER=
# Copiloto (embeddings + respostas). Sem ela, usa a NVIDIA_KEY_SUMMARIZER.
NVIDIA_KEY_COPILOTO=

# Opcional — Claude no Amazon Bedrock para escrever as respostas do copiloto (poucos segundos,
# contra 20–50s da NVIDIA gratuita). Precisa de credenciais da AWS no ambiente (na AWS, vêm do
# papel da task). Ex.: us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# URL do serviço do copiloto (a API chama POST {AI_SERVICE_URL}/ask — ai/servidor.py).
# Sem ela, ou se o serviço cair, o copiloto responde por busca de palavra-chave nos trechos.
# No docker-compose já vem configurada (http://copiloto:8000); rodando local: http://localhost:8000
AI_SERVICE_URL=

# Opcional — sem isso, e-mails (reset de senha, alertas) só ficam logados no
# console, não são enviados de verdade.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@energystart.app
